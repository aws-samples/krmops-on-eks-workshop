#!/usr/bin/env bash
# Skill-side dispatcher: invokes each helper via the toolkit venv so the
# operator never has to `source .venv/bin/activate`.
#
# Usage:
#   ./scripts/run <subcommand> [args...]
#
# Subcommands map 1:1 to the .py files in this directory:
#   discover, crd-inventory, emit-interface, validate-manifest, validate-cel,
#   validate-spec-fields, validate-all, render-report, adopt

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PY="${SCRIPT_DIR}/.venv/bin/python"

if [[ ! -x "${VENV_PY}" ]]; then
  cat >&2 <<EOF
error: Python venv not found at ${VENV_PY}
       Run: bash ${SCRIPT_DIR}/bootstrap.sh
EOF
  exit 2
fi

if [[ $# -lt 1 ]]; then
  cat >&2 <<EOF
usage: $(basename "$0") <subcommand> [args...]

Subcommands:
  discover           Parse tfstate + HCL + live-cluster CRDs -> migrate-set.json
  crd-inventory      List ACK CRDs installed on the target cluster
                     (--schema adds required/immutable/spec/status per Kind; cached)
  emit-interface     Emit the derived half of the shared authoring interface
                     (per-resource tfstate values, live-CRD schemas, mapping table)
  validate-manifest  kubectl dry-run + adoption-annotation invariants
  validate-cel       CEL grammar check on RGD readyWhen / interpolations
  validate-spec-fields  Check every spec field in generated CRs/RGD templates exists in the live CRD
  validate-all       Parallel validate-spec-fields + validate-manifest + validate-cel across all RGDs
                     (--reuse-gates skips a validator whose inline gate output is still fresh)
  render-report      Emit the single-page HTML report
                     (--notes-out --mode also renders MIGRATION-NOTES.md)
  adopt              Apply ACK CRs + poll ACK.ResourceSynced=True (TF state untouched)

Run '$(basename "$0") <subcommand> --help' for per-command flags.
EOF
  exit 2
fi

cmd="$1"; shift
case "${cmd}" in
  discover|crd-inventory|emit-interface|validate-manifest|validate-cel|validate-spec-fields|validate-all|render-report|adopt)
    ;;
  *)
    echo "error: unknown subcommand '${cmd}'" >&2
    exit 2
    ;;
esac

# Subcommands with hyphens map to underscored filenames.
script="${SCRIPT_DIR}/${cmd//-/_}.py"
if [[ ! -f "${script}" ]]; then
  echo "error: helper not found: ${script}" >&2
  exit 2
fi

exec "${VENV_PY}" "${script}" "$@"
